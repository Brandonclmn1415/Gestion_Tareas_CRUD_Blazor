@page "/tasks/create"
@using Gestion_Tareas.Shared.Models
@using Gestion_Tareas_API.Services.Interfaces
@inject NavigationManager Nav
@inject ITaskService TaskService

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-plus-circle me-2"></i>
                        <h4 class="mb-0">Crear Nueva Tarea</h4>
                    </div>
                </div>

                <div class="card-body p-4">
                    <EditForm Model="task" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="alert alert-danger" />

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Título *</label>
                            <InputText class="form-control form-control-lg" @bind-Value="task.Title"
                                       placeholder="Ingresa el título de la tarea" />
                            <div class="form-text">Un título claro y descriptivo</div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-dark">Descripción</label>
                            <InputTextArea class="form-control" @bind-Value="task.Description"
                                           placeholder="Describe los detalles de la tarea..."
                                           rows="4" />
                            <div class="form-text">Opcional, pero recomendado</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold text-dark">Fecha de Vencimiento *</label>
                                <InputDate class="form-control" @bind-Value="task.DueDate" />
                                <div class="form-text">Fecha límite para completar</div>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label class="form-label fw-semibold text-dark">Estado *</label>
                                <InputSelect class="form-select" @bind-Value="task.Status">
                                    <option value="0">📝 Pendiente</option>
                                    <option value="1">🔄 En Progreso</option>
                                    <option value="2">✅ Completada</option>
                                </InputSelect>
                                <div class="form-text">Estado inicial de la tarea</div>
                            </div>
                        </div>

                        <div class="d-flex gap-2 justify-content-end pt-3 border-top">
                            <button type="button" class="btn btn-outline-secondary" @onclick="GoBack">
                                <i class="fas fa-times me-1"></i>Cancelar
                            </button>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="fas fa-save me-1"></i>Guardar Tarea
                            </button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private TaskItem task = new TaskItem
    {
        DueDate = DateTime.Now,
        Status = 0
    };

    private async Task Save()
    {
        try
        {
            await TaskService.CreateTaskAsync(task);
            Nav.NavigateTo("/tasks");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al crear tarea: {ex.Message}");
        }
    }

    private void GoBack()
    {
        Nav.NavigateTo("/tasks");
    }
}
